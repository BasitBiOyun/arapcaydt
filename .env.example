# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Google Gemini API key for primary TTS generation.
# Four free-tier TTS models are tried automatically with the common Achernar voice.
# Kept strictly server-side and never exposed to the client.
GEMINI_API_KEY=

# GEMINI_KEY_ENCRYPTION_SECRET: encrypts teachers' own Google AI Studio keys at rest
# (at least 16 random characters, e.g. `openssl rand -base64 32`). Changing it later
# makes saved teacher keys unreadable; teachers then paste their key again.
GEMINI_KEY_ENCRYPTION_SECRET=

# ELEVENLABS_API_KEY: ElevenLabs API key kept as the automatic narration fallback.
# Kept strictly server-side and never exposed to the client.
ELEVENLABS_API_KEY=

# GOOGLE_VISION_API_KEY: Google Cloud Vision API key that reads the question picture
# (document text detection; far better on printed Arabic). Restrict it to the Cloud Vision API.
# Kept strictly server-side. Empty: the in-browser reader (Tesseract) is used.
GOOGLE_VISION_API_KEY=
# VISION_MONTHLY_LIMIT: readings per calendar month (default 950; Google's first 1000 are free).
# Counted in Supabase (supabase/migrations/20261005_vision_quota.sql must be run); at the limit the
# in-browser reader is used.
VISION_MONTHLY_LIMIT=950
# VISION_DAILY_PER_TEACHER: readings per teacher per day (default 30; admins unlimited). Needs
# supabase/migrations/20261006_vision_daily_client_errors.sql.
VISION_DAILY_PER_TEACHER=30

# Supabase public connection (safe in browser; RLS required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Vercel/server values. Never prefix service_role with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
