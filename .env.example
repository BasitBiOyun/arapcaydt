# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Google Gemini API key for primary TTS generation.
# Four free-tier TTS models are tried automatically with the common Achernar voice.
# Kept strictly server-side and never exposed to the client.
GEMINI_API_KEY=

# GEMINI_KEY_ENCRYPTION_SECRET: encrypts teachers' own Google AI Studio keys at rest
# (at least 16 random characters, e.g. `openssl rand -base64 32`). Changing it later
# makes saved teacher keys unreadable; teachers then paste their key again.
GEMINI_KEY_ENCRYPTION_SECRET=

# ELEVENLABS_API_KEY: ElevenLabs API key kept as the automatic narration fallback.
# Kept strictly server-side and never exposed to the client.
ELEVENLABS_API_KEY=

# Supabase public connection (safe in browser; RLS required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Vercel/server values. Never prefix service_role with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
